# Required: Okta domain (no scheme, e.g. yourco.okta.com)
OKTA_DOMAIN=

# Required: Service app client ID
OKTA_CLIENT_ID=

# Required: Absolute path to private key JSON file
OKTA_PRIVATE_KEY_PATH=

# Required: Space-separated OAuth scopes
OKTA_SCOPES=okta.users.read okta.users.manage okta.groups.read okta.groups.manage okta.apps.read okta.apps.manage okta.logs.read okta.policies.read okta.factors.read okta.factors.manage okta.roles.read okta.devices.read

# Optional: Log level (default: info)
OKTA_MCP_LOG_LEVEL=info

# Optional: Max page size (default: 200)
OKTA_MCP_MAX_PAGE_SIZE=200

# Optional: Request timeout in ms (default: 15000)
OKTA_MCP_REQUEST_TIMEOUT_MS=15000

# Optional: Set false for demo mode (disables write operations)
OKTA_MCP_ALLOW_WRITES=true

# Optional: Audit log directory (default: ./logs)
OKTA_MCP_AUDIT_DIR=./logs

# Required: Okta domain (no scheme, e.g. yourco.okta.com)
OKTA_DOMAIN=

# Required: Service app client ID
OKTA_CLIENT_ID=

# Required: Absolute path to private key JSON file
OKTA_PRIVATE_KEY_PATH=

# Required: Space-separated OAuth scopes. Grant the service app only these.
# Read-only profile (use with OKTA_MCP_ALLOW_WRITES=false):
OKTA_SCOPES=okta.users.read okta.groups.read okta.apps.read okta.logs.read okta.policies.read okta.factors.read okta.roles.read okta.devices.read
# Read and write profile: add only the manage scopes for the write tools you use
# (users: lifecycle, sessions, offboarding; factors: factor reset;
#  groups: membership; apps: assignment).
# OKTA_SCOPES=okta.users.read okta.users.manage okta.groups.read okta.groups.manage okta.apps.read okta.apps.manage okta.logs.read okta.policies.read okta.factors.read okta.factors.manage okta.roles.read okta.devices.read

# Optional: Log level (default: info)
OKTA_MCP_LOG_LEVEL=info

# Optional: Max page size (default: 200)
OKTA_MCP_MAX_PAGE_SIZE=200

# Optional: Request timeout in ms (default: 15000)
OKTA_MCP_REQUEST_TIMEOUT_MS=15000

# Optional: false disables every write tool and drops *.manage scopes from the
# token request. Set true only with the read and write profile above.
# The server treats an unset value as true.
OKTA_MCP_ALLOW_WRITES=false

# Optional: Set true to let clients without MCP elicitation confirm writes by
# passing _confirmed: true. The model supplies that argument itself, so a
# prompt-injected record could trigger a write. Leave false unless every
# session is supervised.
OKTA_MCP_ALLOW_MODEL_CONFIRM=false

# Optional: Audit log directory (default: ./logs)
OKTA_MCP_AUDIT_DIR=./logs
